{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/rough-cut-wiki-video/wiki-step.schema.json",
  "title": "WikiStep",
  "type": "object",
  "required": ["id", "order", "wiki_text", "caption_text", "keywords", "notes"],
  "properties": {
    "id": {"type": "string"}, "order": {"type": "integer", "minimum": 1},
